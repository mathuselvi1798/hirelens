# ---------------------------------------------------------------------------
# Hirelens - backend configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false

# Comma-separated list of origins allowed to call this API (your frontend).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.docx,.txt

# --- AI --------------------------------------------------------------------
# Which provider to use:
#   anthropic - highest quality, prepaid credit required (no free tier)
#   gemini    - has a free tier, good for running this project at no cost
#   null      - AI off; uploading and parsing still work
AI_PROVIDER=gemini

# Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Google Gemini (aistudio.google.com) - free tier
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
AI_MAX_TOKENS=4000
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2
AI_CACHE_ENABLED=true

# --- Database (Phase 4 - unused for now) -----------------------------------
DATABASE_URL=
